# 玩家角色模块

class Player:
    def __init__(self):
        self.name = "Hero"
        self.hp = 100
        self.atk = 10
        self.x = 0
        self.y = 0
        self.speed = 5

    def move(self, dx, dy):
        """玩家移动"""
        self.x += dx * self.speed
        self.y += dy * self.speed
        print(f"🏃 位置: ({self.x}, {self.y})")

    def attack(self):
        """玩家攻击"""
        print(f"⚔️ 造成 {self.atk} 点伤害")

    def hurt(self, damage):
        """受伤"""
        self.hp -= damage
        print(f"❤️ 剩余HP: {self.hp}")
